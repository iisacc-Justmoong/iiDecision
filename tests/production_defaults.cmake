if(NOT SOURCE_ROOT OR NOT BINARY_ROOT)
    message(FATAL_ERROR "SOURCE_ROOT and BINARY_ROOT are required")
endif()
set(probe "${BINARY_ROOT}/production-default-probe")
if(EXISTS "${probe}")
    message(FATAL_ERROR "Refusing to overwrite existing probe")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${SOURCE_ROOT}" -B "${probe}" RESULT_VARIABLE status OUTPUT_QUIET)
if(NOT status EQUAL 0)
    file(REMOVE_RECURSE "${probe}")
    message(FATAL_ERROR "Fresh configuration failed")
endif()
file(READ "${probe}/CMakeCache.txt" cache)
if(NOT cache MATCHES "BUILD_TESTING:BOOL=ON" OR NOT cache MATCHES "IIDECISION_BUILD_EXAMPLES:BOOL=OFF")
    file(REMOVE_RECURSE "${probe}")
    message(FATAL_ERROR "Default build must include tests and exclude examples")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${probe}" --target iiDecisionExample RESULT_VARIABLE example_status OUTPUT_QUIET ERROR_QUIET)
if(example_status EQUAL 0)
    file(REMOVE_RECURSE "${probe}")
    message(FATAL_ERROR "Example target unexpectedly enabled")
endif()
file(REMOVE_RECURSE "${probe}")
