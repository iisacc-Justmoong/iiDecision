if(NOT SOURCE_ROOT OR NOT BINARY_ROOT)
    message(FATAL_ERROR "SOURCE_ROOT and BINARY_ROOT are required")
endif()
file(READ "${SOURCE_ROOT}/LICENSE" license)
if(NOT license MATCHES "Apache License" OR NOT license MATCHES "Version 2.0, January 2004")
    message(FATAL_ERROR "LICENSE must be the Apache License, Version 2.0")
endif()
if(NOT license MATCHES "APPENDIX: How to apply the Apache License")
    message(FATAL_ERROR "LICENSE must include the full Apache-2.0 text")
endif()
if(license MATCHES "Permission is hereby granted")
    message(FATAL_ERROR "LICENSE still contains an MIT grant")
endif()
file(READ "${SOURCE_ROOT}/NOTICE" notice)
if(NOT notice MATCHES "Copyright \\(c\\) 2026 iisacc")
    message(FATAL_ERROR "NOTICE must carry Copyright (c) 2026 iisacc")
endif()
file(READ "${SOURCE_ROOT}/README.md" readme)
if(NOT readme MATCHES "SPDX-License-Identifier: Apache-2.0")
    message(FATAL_ERROR "README must identify Apache-2.0")
endif()
if(readme MATCHES "SPDX-License-Identifier: MIT")
    message(FATAL_ERROR "README still identifies MIT")
endif()
file(READ "${SOURCE_ROOT}/docs/License.md" korean)
if(NOT korean MATCHES "SPDX-License-Identifier: Apache-2.0")
    message(FATAL_ERROR "docs/License.md must identify Apache-2.0")
endif()
file(READ "${SOURCE_ROOT}/CMakeLists.txt" project_cmake)
if(NOT project_cmake MATCHES "install\\(FILES LICENSE NOTICE")
    message(FATAL_ERROR "Install rules must copy LICENSE and NOTICE")
endif()
file(READ "${BINARY_ROOT}/iiDecisionConfig.cmake" config)
if(NOT config MATCHES "set\\(iiDecision_SPDX_LICENSE \"Apache-2.0\"\\)")
    message(FATAL_ERROR "Package config must export iiDecision_SPDX_LICENSE=Apache-2.0")
endif()
