if(NOT DEFINED SOURCE_ROOT)
    message(FATAL_ERROR "SOURCE_ROOT is required")
endif()
file(READ "${SOURCE_ROOT}/CMakeLists.txt" project_cmake)
file(READ "${SOURCE_ROOT}/cmake/iiDecisionConfig.cmake.in" package_cmake)
if("${project_cmake}${package_cmake}" MATCHES "(find_package|find_dependency)[ \t\r\n]*\\([ \t\r\n]*iiGPU|iiGPU::")
    message(FATAL_ERROR "iiDecision must not discover or link iiGPU")
endif()
file(GLOB_RECURSE sources LIST_DIRECTORIES false
    "${SOURCE_ROOT}/src/*.h" "${SOURCE_ROOT}/src/*.cpp" "${SOURCE_ROOT}/src/*.mm")
foreach(source IN LISTS sources)
    file(READ "${source}" contents)
    if(contents MATCHES "#[ \t]*(include|import)[ \t]*[<\"]iiGPU/")
        message(FATAL_ERROR "GPU SDK dependency in ${source}")
    endif()
endforeach()
