set(IIDECISION_LAYA "AUTO" CACHE STRING "Laya model backend: AUTO, ON or OFF")
set_property(CACHE IIDECISION_LAYA PROPERTY STRINGS AUTO ON OFF)
set(IIDECISION_LAYA_RUST_TARGET "" CACHE STRING "Rust target triple for Laya cross compilation")
if(NOT IIDECISION_LAYA MATCHES "^(AUTO|ON|OFF)$")
    message(FATAL_ERROR "IIDECISION_LAYA must be AUTO, ON or OFF")
endif()
set(IIDECISION_HAS_LAYA FALSE)
if(NOT IIDECISION_LAYA STREQUAL "OFF")
    find_program(IIDECISION_CARGO cargo)
    if(IIDECISION_HAS_ONNX AND IIDECISION_CARGO AND (NOT CMAKE_CROSSCOMPILING OR IIDECISION_LAYA_RUST_TARGET))
        set(IIDECISION_HAS_LAYA TRUE)
        set(_laya_source "${CMAKE_CURRENT_SOURCE_DIR}/src/laya_tokenizer")
        set(_laya_output "${CMAKE_CURRENT_BINARY_DIR}/laya-rust")
        set(_laya_target_args)
        if(IIDECISION_LAYA_RUST_TARGET)
            set(_laya_target_args --target "${IIDECISION_LAYA_RUST_TARGET}")
            string(APPEND _laya_output "/${IIDECISION_LAYA_RUST_TARGET}")
        endif()
        if(WIN32)
            set(_laya_archive "${_laya_output}/release/iidecision_laya_tokenizer.lib")
            set(_laya_system_libraries ws2_32 userenv bcrypt ntdll advapi32)
        else()
            set(_laya_archive "${_laya_output}/release/libiidecision_laya_tokenizer.a")
            set(_laya_system_libraries "${CMAKE_DL_LIBS}" m)
        endif()
        add_custom_command(OUTPUT "${_laya_archive}"
            COMMAND "${IIDECISION_CARGO}" build --release --locked
                --manifest-path "${_laya_source}/Cargo.toml"
                --target-dir "${CMAKE_CURRENT_BINARY_DIR}/laya-rust" ${_laya_target_args}
            DEPENDS "${_laya_source}/Cargo.toml" "${_laya_source}/Cargo.lock" "${_laya_source}/src/lib.rs"
            VERBATIM COMMENT "Building the native Hugging Face tokenizer for Laya")
        add_custom_target(iiDecisionLayaTokenizerBuild DEPENDS "${_laya_archive}")
        add_library(iiDecision::LayaTokenizer STATIC IMPORTED GLOBAL)
        set_target_properties(iiDecision::LayaTokenizer PROPERTIES
            IMPORTED_LOCATION "${_laya_archive}"
            INTERFACE_LINK_LIBRARIES "Threads::Threads;${_laya_system_libraries}")
        add_dependencies(iiDecision iiDecisionLayaTokenizerBuild)
        target_compile_definitions(iiDecision PRIVATE IIDECISION_HAS_LAYA)
        target_link_libraries(iiDecision PRIVATE iiDecision::LayaTokenizer)
        install(FILES "${_laya_archive}" DESTINATION "${CMAKE_INSTALL_LIBDIR}")
    elseif(IIDECISION_LAYA STREQUAL "ON")
        message(FATAL_ERROR "Laya requires ONNX Runtime, Cargo, and a matching IIDECISION_LAYA_RUST_TARGET when cross compiling")
    endif()
endif()
message(STATUS "iiDecision Laya model backend: ${IIDECISION_HAS_LAYA}")
