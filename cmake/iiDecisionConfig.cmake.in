@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
if(@IIDECISION_HAS_MLX@)
    find_dependency(MLX 0.32 CONFIG)
endif()
if(@IIDECISION_HAS_OPENCL@)
    find_dependency(OpenCL)
endif()
if(@IIDECISION_HAS_VULKAN@)
    find_dependency(Vulkan 1.1)
endif()
if(@IIDECISION_HAS_ONNX@)
    list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
    find_dependency(ONNXRuntime)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/iiDecisionTargets.cmake")
check_required_components(iiDecision)
