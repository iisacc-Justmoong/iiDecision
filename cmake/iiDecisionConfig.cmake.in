@PACKAGE_INIT@
if(EMSCRIPTEN AND @BUILD_SHARED_LIBS@)
    # Emscripten's CMake toolchain defaults to static libraries even when the
    # installed SDK was deliberately built as a WebAssembly side module.
    set_property(GLOBAL PROPERTY TARGET_SUPPORTS_SHARED_LIBS TRUE)
endif()
include(CMakeFindDependencyMacro)
find_dependency(Threads)
if(@IIDECISION_HAS_MLX@)
    find_dependency(MLX 0.32 CONFIG)
endif()
if(@IIDECISION_HAS_OPENCL@)
    find_dependency(OpenCL)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/iiDecisionTargets.cmake")
check_required_components(iiDecision)
