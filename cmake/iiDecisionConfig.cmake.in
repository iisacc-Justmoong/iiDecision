@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
if(@IIDECISION_HAS_MLX@)
    find_dependency(MLX 0.32 CONFIG)
endif()
if(@IIDECISION_HAS_OPENCL@)
    find_dependency(OpenCL)
endif()
if(@IIDECISION_HAS_VULKAN@)
    find_dependency(Vulkan 1.1)
endif()
if(@IIDECISION_HAS_ONNX@)
    list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
    find_dependency(ONNXRuntime)
endif()
if(@IIDECISION_HAS_LAYA@ AND NOT TARGET iiDecision::LayaTokenizer)
    add_library(iiDecision::LayaTokenizer STATIC IMPORTED)
    if(WIN32)
        set(_laya_archive "iidecision_laya_tokenizer.lib")
        set(_laya_libraries ws2_32 userenv bcrypt ntdll advapi32)
    else()
        set(_laya_archive "libiidecision_laya_tokenizer.a")
        set(_laya_libraries "${CMAKE_DL_LIBS}" m)
    endif()
    set_target_properties(iiDecision::LayaTokenizer PROPERTIES
        IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/${_laya_archive}"
        INTERFACE_LINK_LIBRARIES "Threads::Threads;${_laya_libraries}")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/iiDecisionTargets.cmake")
check_required_components(iiDecision)
